{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "gigem",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-01",
	"workers_dev": false,
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": [
			"/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "gigem",
			"migrations_dir": "migrations"
		}
	],
	"vars": {
		"ENVIRONMENT": "production",
		"ESPN_API_BASE_URL": "https://site.api.espn.com"
	},
	"triggers": {
		"crons": [
			"*/3 * * * *"
		]
	},
	"routes": [
		{
			"pattern": "gigem.lindsey.fyi",
			"zone_name": "lindsey.fyi",
			"custom_domain": true,
			"enabled": true,
			"previews_enabled": false
		}
	],
	"preview_urls": false
}
